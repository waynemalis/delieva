---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLang = Astro.currentLocale || "es";

const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);

const { class: className = "" } = Astro.props;

const site = "https://www.botanasdelieva.com";
const currentUrl = new URL(Astro.url.pathname, site);

const locales = ["es", "en", "jp", "fr"];
---

<!doctype html>
<html lang={currentLang}>
<head>
  <!-- Base -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Title -->
  <title>{translateLabels("site.title")}</title>

  <!-- SEO -->
  <meta
    name="description"
    content={translateLabels("hero.description")}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={currentUrl.toString()}
  />

  <!-- i18n -->
  {
    locales.map(locale => (
      <link
        rel="alternate"
        hreflang={locale}
        href={new URL(
          getRelativeLocaleUrl(locale),
          site
        ).toString()}
      />
    ))
  }

  <link
    rel="alternate"
    hreflang="x-default"
    href={site}
  />

  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta
    property="og:title"
    content={translateLabels("site.title")}
  />

  <meta
    property="og:description"
    content={translateLabels("hero.description")}
  />

  <meta
    property="og:url"
    content={currentUrl.toString()}
  />

  <meta
    property="og:image"
    content={`${site}/delieva.webp`}
  />

  <meta
    property="og:locale"
    content={currentLang}
  />

  <!-- Twitter -->
  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={translateLabels("site.title")}
  />

  <meta
    name="twitter:description"
    content={translateLabels("hero.description")}
  />

  <meta
    name="twitter:image"
    content={`${site}/delieva.webp`}
  />

  <!-- Favicon -->
  <link
    rel="icon"
    type="image/webp"
    href="/favicon.webp"
  />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link href="https://fonts.googleapis.com/css2?family=Neuton:ital,wght@0,200;0,300;0,400;0,700;0,800;1,400&display=swap" rel="stylesheet" />

  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap" rel="stylesheet" />

  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,900;1,100;1,900&display=swap" rel="stylesheet" />

  <link href="https://fonts.googleapis.com/css2?family=Darumadrop+One&display=swap" rel="stylesheet" />

  <!-- Analytics -->
  <script
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="0ad30cb0-f306-464f-b57c-6a1956b14fd7">
  </script>

</head>

<body class={className}>
  <slot />
</body>
</html>

<style>
html {
  margin: 0;
  width: 100%;
  height: 100%;
}

body {
  margin: 0;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
}

body.bg-\[\#062121\] {
  background-color: #062121 !important;
}
</style>