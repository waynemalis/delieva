---
import { motion } from "motion/react"
import { ChevronDown, Languages, ArrowUpRight, Menu } from "lucide-astro";

import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
const currentLang = Astro.currentLocale || "es";

const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);
---

<motion.nav client:load
    className="fixed top-0 w-full z-50 transition-colors bg-[#AED42E] darumadrop"
    initial={{ opacity: 0, y: -50 }}
    animate={{ opacity: 1, y: 0 }}
    transition={{ duration: 0.8 }}
    id="main-nav"
>
    <div id="navbar-main" class="flex items-center justify-center md:justify-between px-4 md:px-16 lg:px-24 xl:px-32 py-3.5 border-b border-transparent">
        <a href={getRelativeLocaleUrl(currentLang, "/")}>
            <img id="logo" src="https://ff456b3a66.cbaul-cdnwnd.com/8f682d027808632abfeb7e44e1febb52/200000032-318a7318a9/450/deliEva.webp?ph=ff456b3a66" alt="Delieva Logo" width="100" height="40" />
        </a>

        <div id="nav-links" class="hidden md:flex items-center text-black text-[18px] font-medium space-x-8 absolute translate-x-52">
            <a id="nav-inicio" href="#" class="hover:text-gray-800 transition">{translateLabels("nav.home")}</a>

            <button id="quienes-btn" class="hover:text-gray-800 transition flex items-center space-x-1 cursor-pointer">
                <span>{translateLabels("nav.explore")}</span>
                <ChevronDown id="quienes-icon" class="transition-transform duration-300" size={18} />
            </button>
        </div>

        <div class="hidden md:flex items-center space-x-1 bg-white px-0.5 py-0.5 text-slate-800 rounded-full border border-gray-200">
            <button id="language-btn" class="flex items-center space-x-1 px-3 py-2 rounded-full font-medium hover:bg-[#CDDC3980] transition cursor-pointer">
                <Languages size={18} color="#24944B" />
                <span class="uppercase">{currentLang}</span>
                <ChevronDown id="language-icon" class="transition-transform duration-300" size={18} />
                <div class="absolute top-full -translate-x-1 -translate-y-5 w-18 bg-white h-auto rounded-lg shadow-lg overflow-hidden transition-all duration-300 ease-in-out opacity-0 pointer-events-none z-50" id="desktop-language-dropdown">
                    {
                        Object.entries(languageList).map(
                        ([key, label]: [string, string]) => {
                            return (
                            <a href={getRelativeLocaleUrl(key, "/brands")} class="flex items-center justify-center space-x-2 py-2 text-gray-800 hover:bg-gray-200 transition">
                                <img src={`/src/assets/flags/${key}.svg`} alt={label} class="w-5 h-5">
                                <span class="text-sm font-medium uppercase">{key}</span>
                            </a>
                            );
                        }
                        )
                    }
                </div>
            </button>
        </div>
    </div>

    <div id="navbar-dropdown" class="fixed flex w-full max-h-0 transition-all duration-200 items-start space-x-16 px-4 md:px-16 lg:px-24 xl:px-32 py-3.5 border-b border-gray-200 opacity-0 pointer-events-none overflow-hidden">
        <span class="justify-start p-6 text-[#24944B] text-3xl font-medium">{translateLabels("nav.explore")}</span>

        <div class="inline-block w-0.5 self-stretch bg-black/25"></div>

        <div id="who-items" class="w-85 bg-neutral-primary-soft">
            <ul role="list" class="space-y-4 p-6 text-lg font-medium">
                <li class="group flex border-b border-black/25 cursor-pointer">
                    <a href="#featured" class="flex items-center space-x-2">
                        <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("nav.featured")}</span>
                        <ArrowUpRight size={16} class="shrink-0 text-black/25 group-hover:text-[#24944B] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300" />
                    </a>
                </li>
                <li class="group flex items-center space-x-2 border-b border-black/25 cursor-pointer">
                    <a href="#catalog" class="flex items-center space-x-2">
                        <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("brands.catalog")}</span>
                        <ArrowUpRight size={16} class="shrink-0 text-black/25 group-hover:text-[#24944B] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300" />
                    </a>
                </li>
                <li class="group flex items-center space-x-2 cursor-pointer">
                    <a href="#quality" class="flex items-center space-x-2">
                        <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("who.quality")}</span>
                        <ArrowUpRight size={16} class="shrink-0 text-black/25 group-hover:text-[#24944B] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300" />
                    </a>
                </li>
            </ul>
        </div>
        <div class="w-85 bg-neutral-primary-soft">
            <ul role="list" class="space-y-4 p-6 text-lg font-medium">
                <a href="#logistics" class="flex items-center space-x-2">
                    <li class="group flex items-center space-x-2 border-b border-black/25 cursor-pointer">
                        <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("logistic.distributors")}</span>
                        <ArrowUpRight size={16} class="shrink-0 text-black/25 group-hover:text-[#24944B] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300" />
                    </li>
                </a>
                <a href="#logistics" class="flex items-center space-x-2">
                    <li class="group flex items-center space-x-2 border-b border-black/25 cursor-pointer">
                        <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("logistic.shipping")}</span>
                        <ArrowUpRight size={16} class="shrink-0 text-black/25 group-hover:text-[#24944B] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300" />
                    </li>
                </a>
                <a href="#location" class="flex items-center space-x-2">
                    <li class="group flex items-center space-x-2 cursor-pointer">
                        <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("who.location")}</span>
                        <ArrowUpRight size={16} class="shrink-0 text-black/25 group-hover:text-[#24944B] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300" />
                    </li>
                </a>
            </ul>
        </div>
    </div>
</motion.nav>

<div id="mobile-navbar" class="fixed flex w-full h-full bg-black/80 backdrop-blur-sm md:hidden z-99 opacity-0 pointer-events-none transition-opacity duration-300">
    <ul role="list" class="flex flex-col justify-center space-y-4 w-full p-6 text-lg font-medium">
        <a href="#" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("nav.home")}</span>
            </li>
        </a>
        <li class="group flex w-full justify-center text-white/50 items-center space-x-2 mt-8 py-2">
            <span class="text-body truncate">{translateLabels("nav.explore")}</span>
        </li>
        <a href="#featured" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("nav.featured")}</span>
            </li>
        </a>
        <a href="#quality" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("who.quality")}</span>
            </li>
        </a>
        <a href="#catalog" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("brands.catalog")}</span>
            </li>
        </a>
        <a href="#logistics" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("logistic.distributors")}</span>
            </li>
        </a>
        <a href="#logistics" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("logistic.shipping")}</span>
            </li>
        </a>
        <a href="#map" class="flex items-center space-x-2">
            <li class="group flex w-full justify-center text-white items-center space-x-2 border-b-2 border-[#24944B] py-2 cursor-pointer">
                <span class="text-body truncate group-hover:text-[#24944B] transition-colors duration-300">{translateLabels("who.location")}</span>
            </li>
        </a>
    </ul>
    <div class="fixed bottom-4 right-4 flex items-center space-x-1 bg-white px-0.5 py-0.5 text-slate-800 rounded-full border border-gray-200 z-50">
        <button id="language-btn2" class="flex items-center space-x-1 px-3 py-2 rounded-full font-medium hover:bg-[#CDDC3980] cursor-pointer transition">
            <Languages size={18} color="#24944B" />
            <span class="uppercase">{currentLang}</span>
            <ChevronDown size={18} />
            <div class="absolute bottom-full right-0 mb-1 w-24 bg-white rounded-lg shadow-lg overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 z-[101]" id="desktop-language-dropdown2">
                {
                    Object.entries(languageList).map(
                    ([key, label]: [string, string]) => {
                        return (
                        <a href={getRelativeLocaleUrl(key, "/brands")} class="flex items-center justify-center space-x-2 py-2 text-gray-800 hover:bg-gray-200 transition">
                            <img src={`/src/assets/flags/${key}.svg`} alt={label} class="w-5 h-5">
                            <span class="text-sm font-medium uppercase">{key}</span>
                        </a>
                        );
                    }
                    )
                }
            </div>
        </button>
     </div>
</div>

<div id="wa" class="group fixed bottom-4 right-4 z-49">
    <a href="https://wa.me/526391151801" target="_blank" class="flex items-center w-16 h-16 rounded-full">
        <img src="/src/assets/whatsapp.png" alt="WhatsApp" class="drop-shadow group-hover:scale-110 transition-transform duration-300">
    </a>
</div>

<div id="mobile-nav-toggle" class="fixed bottom-4 left-1/2 -translate-x-1/2 md:hidden items-center space-x-1 bg-white p-4 text-slate-800 rounded-full border border-gray-200 z-100">
    <Menu size={24} />
</div>

<script>
    const mobileNavToggle = document.getElementById('mobile-nav-toggle');
    const mobileNavbar = document.getElementById('mobile-navbar');
    
    mobileNavToggle?.addEventListener('click', () => {
        if (!mobileNavbar) return;
        
        const isOpen = mobileNavbar.classList.contains('opacity-0');
        
        if (isOpen) {
            mobileNavbar.classList.replace('opacity-0', 'opacity-100');
            mobileNavbar.classList.replace('pointer-events-none', 'pointer-events-auto');
        } else {
            mobileNavbar.classList.replace('opacity-100', 'opacity-0');
            mobileNavbar.classList.replace('pointer-events-auto', 'pointer-events-none');
        }
    });
</script>

<style>
    #logo {
        filter: drop-shadow(0 2px 0 rgb(255, 255, 255)) 
                drop-shadow(-2px 0 0 white) 
                drop-shadow(2px 0 0 white) 
                drop-shadow(0 -2px 0 white) 
                drop-shadow(0 2px 0 white);
    }
</style>

<script>
    const btn = document.getElementById('quienes-btn');
    const links = document.getElementById('nav-links');
    const dropdown = document.getElementById('navbar-dropdown');
    const nav = document.getElementById('main-nav');
    const mainNav = document.getElementById('navbar-main');
    const icon = document.getElementById('quienes-icon');
    const languageBtn = document.getElementById('language-btn');
    const languageDropdown = document.getElementById('desktop-language-dropdown');
    const languageIcon = document.getElementById('language-icon');
    const whoItems = document.getElementById('who-items');
    const navLinks = [
        document.getElementById('nav-inicio'),
        document.getElementById('quienes-btn'),
        document.getElementById('nav-marcas'),
    ];

    let isOpen = false;
    let isScrolled = false;
    let isLanguageOpen = false;

    function openDropdown() {
        isOpen = true;
        links?.classList.replace('text-white', 'text-slate-800');
        mainNav?.classList.replace('border-transparent', 'border-black/25');
        dropdown?.classList.add('bg-white');
        icon?.classList.add('rotate-180');
        
        // Animación suave del dropdown
        dropdown?.classList.replace('opacity-0', 'opacity-100');
        dropdown?.classList.replace('pointer-events-none', 'pointer-events-auto');
        dropdown?.classList.replace('max-h-0', 'max-h-96');
        
        navLinks.forEach(el => {
            el?.classList.replace('text-white', 'text-slate-800');
            el?.classList.replace('hover:text-gray-300', 'hover:text-[#24944B]');
        });
    }

    function closeDropdown() {
        isOpen = false;
        icon?.classList.remove('rotate-180');
        dropdown?.classList.replace('opacity-100', 'opacity-0');
        dropdown?.classList.replace('pointer-events-auto', 'pointer-events-none');
        dropdown?.classList.replace('max-h-96', 'max-h-0');
        
        // Solo restaurar a estado transparente si está en el tope
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        if (scrollTop === 0) {
            links?.classList.replace('text-slate-800', 'text-white');
            mainNav?.classList.replace('border-black/25', 'border-transparent');
            
            navLinks.forEach(el => {
                el?.classList.replace('text-slate-800', 'text-white');
                el?.classList.replace('hover:text-[#24944B]', 'hover:text-gray-300');
            });
        }
    }

    function handleScroll() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        
        if (scrollTop > 0 && !isScrolled) {
            // Scroll hacia abajo - cambiar a fondo blanco
            isScrolled = true;
            links?.classList.replace('text-white', 'text-slate-800');
            mainNav?.classList.replace('border-transparent', 'border-black/25');
            
            navLinks.forEach(el => {
                el?.classList.replace('text-white', 'text-slate-800');
                el?.classList.replace('hover:text-gray-300', 'hover:text-[#24944B]');
            });
        } else if (scrollTop === 0 && isScrolled && !isOpen) {
            // Volver al tope - restaurar fondo transparente
            isScrolled = false;
            links?.classList.replace('text-slate-800', 'text-white');
            mainNav?.classList.replace('border-black/25', 'border-transparent');
            
            navLinks.forEach(el => {
                el?.classList.replace('text-slate-800', 'text-white');
                el?.classList.replace('hover:text-[#24944B]', 'hover:text-gray-300');
            });
        }
    }

    btn?.addEventListener('click', () => isOpen ? closeDropdown() : openDropdown());

    // Agregar evento para cerrar dropdown al hacer clic en cualquier li de who-items
    whoItems?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('li')) {
            closeDropdown();
        }
    });

    // Funcionalidad del dropdown de idioma
    function toggleLanguageDropdown(e: Event) {
        e.stopPropagation();
        isLanguageOpen = !isLanguageOpen;
        
        if (isLanguageOpen) {
            languageDropdown?.classList.replace('max-h-0', 'max-h-32');
            languageDropdown?.classList.replace('opacity-0', 'opacity-100');
            languageDropdown?.classList.replace('pointer-events-none', 'pointer-events-auto');
            languageIcon?.classList.add('rotate-180');
        } else {
            languageDropdown?.classList.replace('max-h-32', 'max-h-0');
            languageDropdown?.classList.replace('opacity-100', 'opacity-0');
            languageDropdown?.classList.replace('pointer-events-auto', 'pointer-events-none');
            languageIcon?.classList.remove('rotate-180');
        }
    }

    function closeLanguageDropdown() {
        if (isLanguageOpen) {
            isLanguageOpen = false;
            languageDropdown?.classList.replace('max-h-32', 'max-h-0');
            languageDropdown?.classList.replace('opacity-100', 'opacity-0');
            languageDropdown?.classList.replace('pointer-events-auto', 'pointer-events-none');
            languageIcon?.classList.remove('rotate-180');
        }
    }

    languageBtn?.addEventListener('click', toggleLanguageDropdown);

    document.addEventListener('click', (e) => {
        if (isOpen && !nav?.contains(e.target as Node)) closeDropdown();
        if (isLanguageOpen && !languageBtn?.contains(e.target as Node)) closeLanguageDropdown();
    });

    window.addEventListener('scroll', handleScroll);
</script>

<script>
    const languageBtn2 = document.getElementById('language-btn2');
    const languageDropdown2 = document.getElementById('desktop-language-dropdown2');
    
    // Inicializar el dropdown con estilos
    if (languageDropdown2) {
        languageDropdown2.style.maxHeight = '0px';
        languageDropdown2.style.opacity = '0';
        languageDropdown2.style.transition = 'all 0.3s ease-in-out';
    }
    
    languageBtn2?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!languageDropdown2) return;
        
        const isOpen = languageDropdown2.style.maxHeight && languageDropdown2.style.maxHeight !== '0px';
        
        if (isOpen) {
            languageDropdown2.style.maxHeight = '0px';
            languageDropdown2.style.opacity = '0';
        } else {
            languageDropdown2.style.maxHeight = '200px';
            languageDropdown2.style.opacity = '1';
        }
    });
    
    // Cerrar dropdown al hacer clic fuera
    document.addEventListener('click', (e) => {
        if (languageDropdown2 && !languageBtn2?.contains(e.target as Node)) {
            languageDropdown2.style.maxHeight = '0px';
            languageDropdown2.style.opacity = '0';
        }
    });
</script>