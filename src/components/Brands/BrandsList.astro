---
import { motion } from "motion/react";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
import { Image } from "astro:assets";
import chipsCamote from "../../assets/brands/chips_camote.png";
import hotNuts from "../../assets/brands/hot_nuts.png";
import nuts from "../../assets/brands/nuts.png";
import pipitoria from "../../assets/brands/pipitoria_palanqueta.png";
import popcorn from "../../assets/brands/popcorn.png";
import rainbowNuts from "../../assets/brands/Raindow_nuts.png";

const currentLang = Astro.currentLocale || "es";
const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);

const slides = [
  { src: chipsCamote, href: "#chips" },
  { src: hotNuts,     href: "#hot-nuts" },
  { src: nuts,        href: "#nuts" },
  { src: pipitoria,   href: "#pipitorias" },
  { src: popcorn,     href: "#popcorn" },
  { src: rainbowNuts, href: "#hot-rainbow" },
];
---

<motion.section className="flex flex-col items-center">
    <span class="text-4xl text-[#062121] mt-16 darumadrop">{translateLabels("nav.brands")}</span>
    <div id="embla-brands" class="w-full mt-12 items-center justify-center overflow-hidden darumadrop">
        <ul class="flex gap-8 w-full text-center text-[18px] whitespace-pre-line leading-relaxed z-10 select-none cursor-grab active:cursor-grabbing">
            {slides.map((slide) => (
                <li class="relative min-w-[150px] md:min-w-[300px] h-[180px] gap-6 bg-white px-4 py-8 rounded-lg">
                    <a href={slide.href} class="group flex flex-col items-center justify-center h-full gap-4">
                        <Image
                            src={slide.src}
                            alt=""
                            class="h-auto group-hover:scale-110 transition-transform duration-300"
                        />
                    </a>
                </li>
            ))}
        </ul>
    </div>
</motion.section>

<script>
    import EmblaCarousel from 'embla-carousel';
    import Autoplay from 'embla-carousel-autoplay';

    const emblaNode = document.querySelector('#embla-brands') as HTMLElement;
    if (emblaNode) {
        EmblaCarousel(emblaNode, {
            loop: true,
            align: 'center',
            dragFree: false,
            containScroll: false,
            slidesToScroll: 1,
        }, [Autoplay({ delay: 2500, playOnInit: true, stopOnInteraction: false })]);
    }
</script>