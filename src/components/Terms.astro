---
import MotionDiv from "./motion/MotionDiv.tsx";
import MotionSection from "./motion/MotionSection.tsx";
import MotionH1 from "./motion/MotionH1.tsx";
import MotionP from "./motion/MotionP.tsx";
import MotionSpan from "./motion/MotionSpan.tsx";
import MotionImg from "./motion/MotionImg.tsx";

import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";
import { getImage } from "astro:assets";
import heroPng from "../assets/hero.png";

const currentLang = Astro.currentLocale || "es";
const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);

const heroImage = await getImage({ src: heroPng });

const termsModules = import.meta.glob(
  '../content/terms/*.md'
);

const path = `../content/terms/${currentLang}.md`;

const module = await termsModules[path]() as { default: any };
const Content = module.default;
---

<section id="terms-hero" class="flex flex-col items-center text-center text-sm font-google-sans-flex text-white max-md:px-2 pt-20 pb-15 md:pt-20 md:pb-20 relative">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImage.src}')`}></div>
    <div class="absolute inset-0 bg-black/60"></div>

    <!-- <div class="flex flex-wrap items-center justify-center px-4 py-2 rounded-full border border-slate-400 relative z-10">
        <p>{translateLabels("hero.slogan")}</p>
    </div> -->
    <MotionH1 client:load 
        className="text-[45px]/[52px] md:text-6xl/[72px] mt-6 max-w-6xl relative title-institutional z-10"
        initial={{ opacity: 0, y: 30 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.8, delay: 0.6 }}
    >
        {translateLabels("footer.terms")}
    </MotionH1>
</section>
<section id="terms-content" class="max-w-4xl mx-auto px-4 py-12">
    <article class="prose w-full">
        <Content />
    </article>
</section>