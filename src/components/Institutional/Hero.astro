---
import { motion } from "motion/react";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
import { getImage } from "astro:assets";
import heroPng from "../../assets/hero.png";

const currentLang = Astro.currentLocale || "es";
const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);

const heroImage = await getImage({ src: heroPng });
---

<section id="hero" class="flex flex-col items-center text-center text-sm font-google-sans-flex text-white max-md:px-2 pt-30 pb-20 md:pt-40 md:pb-40 relative">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImage.src}')`}></div>
    <div class="absolute inset-0 bg-black/60"></div>

    <!-- <div class="flex flex-wrap items-center justify-center px-4 py-2 rounded-full border border-slate-400 relative z-10">
        <p>{translateLabels("hero.slogan")}</p>
    </div> -->
    <motion.h1 client:load 
        className="text-[45px]/[52px] md:text-8xl/[80px] mt-6 max-w-4xl relative title-institutional z-10"
        initial={{ opacity: 0, y: 30 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.8, delay: 0.6 }}
    >
        {translateLabels("hero.slogan")}
    </motion.h1>
    <motion.p client:load 
        className="text-base text-[45px]/[52px] md:text-xl tracking-wide mt-3 md:mt-12 max-w-3xl relative z-10"
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.8, delay: 0.8 }}
    >
        {translateLabels("hero.description")}
    </motion.p>

    <motion.div client:load
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.8, delay: 1 }}
    >
        <motion.div client:load
        className="bg-white mt-8 text-slate-800 text-nowrap antialiased px-8 md:px-10 h-12 mr-2 rounded-full font-medium flex items-center justify-center cursor-pointer select-none relative z-10"
        whileHover={{
            scale: 1.05,
            backgroundColor: "#2BB95D",
            color: "#FFF",
            transition: { 
                duration: 0.2,
                ease: "easeInOut"
            },
        }}
        whileTap={{
            scale: 0.95,
            backgroundColor: "#24944B",
            transition: { 
                duration: 0.1,
                ease: "easeInOut"
            },
        }}
    >
        {translateLabels("hero.contact")}
    </motion.div>
    </motion.div>
</section>