---
import { motion } from "motion/react";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
import { Image } from "astro:assets";
import img1 from "../../assets/production/1.jpg";
import img2 from "../../assets/production/2.jpg";
import img3 from "../../assets/production/3.jpg";
import img4 from "../../assets/production/4.jpg";
import img5 from "../../assets/production/5.jpg";
import img6 from "../../assets/production/6.jpg";
import img7 from "../../assets/production/7.jpg";

const currentLang = Astro.currentLocale || "es";
const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);

const slides = [
  { src: img1, opacity: "opacity-50" },
  { src: img2, opacity: "opacity-50" },
  { src: img3, opacity: "opacity-100" },
  { src: img4, opacity: "opacity-50" },
  { src: img5, opacity: "opacity-100" },
  { src: img6, opacity: "opacity-100" },
  { src: img7, opacity: "opacity-100" },
];
---

<motion.section className="flex flex-col items-center mb-16">
    <div id="embla-brands" class="w-full items-center justify-center py-8 overflow-hidden">
        <ul class="flex w-full z-10 select-none cursor-grab active:cursor-grabbing">
            {slides.map((slide, i) => (
                <li class={`embla-slide min-w-[100vw] h-[140px] md:min-w-[300px] md:h-[200px] px-2 ${slide.opacity} scale-90 transition-all duration-300 rounded-lg`}>
                    <Image
                        src={slide.src}
                        alt=""
                        class="w-full h-full object-cover rounded-lg"
                    />
                </li>
            ))}
        </ul>
    </div>
</motion.section>

<script>
    import EmblaCarousel from 'embla-carousel';
    import Autoplay from 'embla-carousel-autoplay';

    const emblaNode = document.querySelector('#embla-brands') as HTMLElement;
    if (emblaNode) {
        const embla = EmblaCarousel(emblaNode, {
            loop: true,
            align: 'center',
            dragFree: false,
            containScroll: false,
            slidesToScroll: 1,
        }, [Autoplay({ delay: 2500, playOnInit: true, stopOnInteraction: false })]);

        const updateOpacity = () => {
            const slides = emblaNode.querySelectorAll('.embla-slide');
            const selectedIndex = embla.selectedScrollSnap();
            
            slides.forEach((slide, index) => {
                if (index === selectedIndex) {
                    (slide as HTMLElement).classList.remove('opacity-50');
                    (slide as HTMLElement).classList.add('opacity-100');
                    (slide as HTMLElement).classList.replace('scale-90', 'scale-105');
                } else {
                    (slide as HTMLElement).classList.remove('opacity-100');
                    (slide as HTMLElement).classList.add('opacity-50');
                    (slide as HTMLElement).classList.replace('scale-105', 'scale-90');
                }
            });
        };

        embla.on('select', updateOpacity);
        embla.on('init', updateOpacity);
    }
</script>