---
import { motion } from "motion/react";
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
import { Image } from "astro:assets";
import qualityImg from "../../assets/quality.jpg";

const currentLang = Astro.currentLocale || "es";
const translateLabels = useTranslations(
  currentLang as keyof typeof languageList
);
---

<section id="quality" class="overflow-x-hidden">

  <!-- ── MOBILE ── -->
  <div class="flex md:hidden flex-col w-full mt-16 mb-16 px-6 gap-6">
    <div class="w-full overflow-hidden rounded-xl">
      <Image
        src={qualityImg}
        alt="Quality"
        class="w-full h-[260px] object-cover"
      />
    </div>
    <div class="flex flex-col gap-4">
      <h3 class="text-4xl font-medium text-center font-google-sans-flex">
        {translateLabels("who.quality")}
      </h3>
      <p class="text-center font-google-sans-flex text-[17px] leading-relaxed text-neutral-700 whitespace-pre-line">
        {translateLabels("quality.content")}
      </p>
    </div>
  </div>

  <!-- ── DESKTOP ── -->
  <div class="hidden md:block relative mt-16 mb-16 h-[800px]">
    <div class="sticky top-0 h-[800px] overflow-hidden">

      <!-- IMAGEN: fullscreen → mitad izquierda -->
      <motion.div
        client:load
        className="absolute overflow-hidden z-10"
        initial={{
          width: "100vw",
          height: "100vh",
          top: "0px",
          left: "0px",
          borderRadius: "0px",
          padding: "0px",
        }}
        whileInView={{
          width: "50%",
          height: "800px",
          top: "0px",
          left: "0px",
          borderRadius: "0px",
          padding: "40px",
        }}
        transition={{
          duration: 1.3,
          ease: [0.24, 0, 0.24, 1],
        }}
        viewport={{ amount: 0.8 }}
      >
        <Image
          src={qualityImg}
          alt="Quality"
          class="w-full h-full object-cover rounded-lg"
        />
      </motion.div>

      <!-- TEXTO: mitad derecha -->
      <div class="absolute z-9 right-0 top-0 w-1/2 h-[800px] flex items-center justify-center">
        <motion.div
          client:load
          className="xl:w-3/4 p-8 md:p-16"
          initial={{ opacity: 0, x: 50 }}
          whileInView={{ opacity: 1, x: 0 }}
          transition={{
            duration: 0.9,
            delay: 0.5,
            ease: [0.24, 0, 0.24, 1],
          }}
          viewport={{ amount: 0.8 }}
        >
          <h3 class="text-5xl font-medium mb-8 text-left title-institutional">
            {translateLabels("who.quality")}
          </h3>
          <p class="text-justify font-google-sans-flex text-[18px] whitespace-pre-line leading-relaxed h-[280px] overflow-hidden text-neutral-700">
            {translateLabels("quality.content")}
          </p>
        </motion.div>
      </div>

    </div>
  </div>

</section>