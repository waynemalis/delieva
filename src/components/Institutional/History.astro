---
import { motion } from "framer-motion";
import { ArrowRight } from "lucide-astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
import { Image } from "astro:assets";
import historyPng from "../../assets/history.png";

const currentLang = Astro.currentLocale || "es";
const translateLabels = useTranslations(currentLang as keyof typeof languageList);
---

<section class="overflow-x-hidden">
  <motion.div client:load
    className="flex flex-col w-full h-auto"
    id="history" 
    initial={{ x: 150, opacity: 0 }}
    whileInView={{ x: 0, opacity: 1 }}
    transition={{ duration: 0.6 }}
  >
    <div class="group flex flex-row w-full flex-wrap">
      <div class="flex flex-col items-center justify-center min-h-[300px] p-8 md:p-16 w-full md:w-1/2 overflow-hidden">
        <div class="xl:w-3/4 relative">
          <div class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full bg-[#CDDC3980]/50 pointer-events-none z-[-1] group-hover:scale-150 transition-transform duration-300"></div>
          <h3 class="text-5xl font-google-sans-flex font-medium mb-8 text-center md:text-left self-center md:self-start relative z-10 title-institutional">{translateLabels("who.history")}</h3>
          <p id="history-content" class="text-center md:text-justify text-[18px] whitespace-pre-line leading-relaxed w-full max-h-[280px] overflow-hidden mask-b-from-50% mask-b-to-100% relative z-10 transition-all duration-500 ease-in-out">
            {translateLabels("history.content")}
          </p>
          <div class="flex justify-center md:justify-start mt-8">
            <button
              id="read-more-btn"
              data-read-more={translateLabels("who.readMore")}
              data-read-less={translateLabels("who.readLess")}
              class="group/btn px-6 py-3 bg-[#CDDC3980] text-black font-google-sans-flex font-medium rounded-lg hover:text-white hover:bg-[#2BB95D] transition-colors flex items-center space-x-2 cursor-pointer relative z-10"
            >
              <span>{translateLabels("who.readMore")}</span>
              <ArrowRight class="transition-transform duration-300 group-hover/btn:translate-x-1" size={20} />
            </button>
          </div>
        </div>
      </div>

      <div class="relative hidden md:flex flex-col h-auto w-full md:w-1/2 p-10 overflow-hidden">
        <Image
          src={historyPng}
          alt="History"
          class="w-full h-full object-cover rounded-lg group-hover:scale-101 mask-b-from-65% mask-b-to-95% transition-transform duration-300"
        />
        <div class="absolute top-0 left-0 translate-x-[75%] translate-y-[35%] w-80 h-80 rounded-full bg-sky-400/25 pointer-events-none z-[-1] mask-b-from-65% mask-b-to-85% scale-150 blur-sm group-hover:blur-md group-hover:scale-180 transition-transform duration-300"></div>
      </div>
    </div>
  </motion.div>
</section>

<script>
  const readMoreBtn = document.getElementById('read-more-btn');
  const historyContent = document.getElementById('history-content');

  const readMoreText = readMoreBtn?.dataset.readMore ?? '';
  const readLessText = readMoreBtn?.dataset.readLess ?? '';
  let isExpanded = false;

  readMoreBtn?.addEventListener('click', () => {
    isExpanded = !isExpanded;

    if (isExpanded) {
      historyContent?.classList.remove('max-h-[280px]', 'mask-b-from-50%', 'mask-b-to-100%');
      historyContent?.classList.add('max-h-[2000px]');
      readMoreBtn.querySelector('span')!.textContent = readLessText;
    } else {
      historyContent?.classList.add('max-h-[280px]', 'mask-b-from-50%', 'mask-b-to-100%');
      historyContent?.classList.remove('max-h-[2000px]');
      readMoreBtn.querySelector('span')!.textContent = readMoreText;
    }
  });
</script>